DATABASE_URL=sqlite:///./navora.db
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_SOURCE=mock
DATASET_PATH=
AUTO_CREATE_SCHEMA=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_READ_ONLY=true
TRADING_EXECUTION_ENABLED=false

# Required for MT5 timestamp normalization. Set only from verified broker-time evidence;
# the application does not infer this value from the host timezone.
V3_MT5_SERVER_UTC_OFFSET_SECONDS=<set-from-broker>

API_AUTH_REQUIRED=true
API_KEY=
API_RATE_LIMIT_PER_MINUTE=120
RUNTIME_STATE_PATH=runtime/worker_state.json
WORKER_LEASE_SECONDS=30
MT5_BROKER=Raw Trading Ltd
MT5_SERVER=ICMarketsSC-Demo

# Relative paths resolve from the project root, never the process working directory.
NAVORA_DATABASE_PATH=navora.db
NAVORA_API_SECRET=
API_AUTH_REQUIRED=true
